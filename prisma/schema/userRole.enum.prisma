enum UserRole {
  /**
   * Semua orang yang bisa akses website
   * Hak:
   * 1. Melihat halaman /dashboard
   */
  USER

  /**
   * Admin dari website, bukan admin organisasi
   * Hak:
   * 1. Melihat halaman /users
   * 2. Bisa create, read, dan update
   */
  ADMIN

  /**
   * Super Admin dari website
   * Hak:
   * 1. Memiliki hak akses semua halaman
   * 2. Bisa create, read, update, dan delete
   */
  SUPER_ADMIN

  @@map("user_role")
}
