model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  name     String @db.VarChar(255)

  // --- Tahap 1: Verifikasi Email ---
  emailVerifiedAt DateTime? @map("email_verified_at")

  // --- Tahap 2: Verifikasi Owner ---
  status     UserStatus @default(PENDING_EMAIL)
  approvedAt DateTime?  @map("approved_at")

  // Menyimpan ID owner yang memberikan approval
  // Relasi self-referencing ke tabel User ini sendiri
  approvedById String? @map("approved_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        OrganizationUser[]
  emailVerifications EmailVerification[]
  approvedBy         User?               @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedUsers      User[]              @relation("UserApprovals")

  @@map("users")
}
