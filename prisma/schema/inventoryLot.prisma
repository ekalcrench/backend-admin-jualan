model InventoryLot {
  id                  String  @id @default(uuid()) @db.Uuid
  inventoryItemId     String  @map("inventory_item_id") @db.Uuid
  purchaseItemId      String  @unique @map("purchase_item_id") @db.Uuid
  preparationOutputId String? @unique @map("preparation_output_id") @db.Uuid

  quantity          Decimal @db.Decimal(15, 2)
  remainingQuantity Decimal @map("remaining_quantity") @db.Decimal(15, 2)
  unitCost          Decimal @map("unit_cost") @db.Decimal(15, 3)
  totalCost         Decimal @map("total_cost") @db.Decimal(15, 2)

  receivedAt DateTime  @map("received_at")
  expiredAt  DateTime? @map("expired_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relationships
  inventoryItem         InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  purchaseItem          PurchaseItem           @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  inventoryConsumptions InventoryConsumption[]
  preparationOutput     Preparation?           @relation(fields: [preparationOutputId], references: [id])
  preparationItems      PreparationItem[]

  @@index([inventoryItemId, receivedAt])
  @@index([purchaseItemId])
  @@map("inventory_lots")
}
