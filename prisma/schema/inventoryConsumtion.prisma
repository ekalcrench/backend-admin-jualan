model InventoryConsumption {
  id             String @id @default(uuid()) @db.Uuid
  orderItemId    String @map("order_item_id") @db.Uuid
  inventoryLotId String @map("inventory_lot_id") @db.Uuid

  quantity  Decimal @db.Decimal(15, 2)
  unitCost  Decimal @map("unit_cost") @db.Decimal(15, 3)
  totalCost Decimal @map("total_cost") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  inventoryLot InventoryLot @relation(fields: [inventoryLotId], references: [id])

  @@index([orderItemId])
  @@index([inventoryLotId])
  @@map("inventory_consumptions")
}
